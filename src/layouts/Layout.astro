---
// Cinzel: the Roman capitals of the logo's "BARBER". Hanken: body.
// Pinyon (the script) is imported only by the component that uses it.
import '@fontsource-variable/cinzel';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';

// Resolved through Vite so the preload points at the real hashed asset.
import cinzelWoff from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';

import { business, services, hours, reviews } from '../data/content.js';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${business.name} — Barbería en Berja, Almería | Corte y barba`,
  description = `${business.tagline}. Corte y barba de precisión en Berja, Almería. ${business.rating}★ con ${business.reviewCount} reseñas verificadas. Reserva online con Azedin, Samir o Anas.`,
} = Astro.props;

const site = Astro.site ?? 'https://azedinbarber.com';
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL('/og-image.jpg', site).href;

// Schema is generated from content.js so it can never drift from the page.
const dayMap = {
  Lunes: 'Monday',
  Martes: 'Tuesday',
  Miércoles: 'Wednesday',
  Jueves: 'Thursday',
  Viernes: 'Friday',
  Sábado: 'Saturday',
  Domingo: 'Sunday',
};

const openingHours = hours.flatMap((h) =>
  h.slots.map((slot) => {
    const [opens, closes] = slot.split('–').map((s) => s.trim());
    return {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: `https://schema.org/${dayMap[h.day]}`,
      opens,
      closes,
    };
  })
);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BarberShop',
  '@id': `${site}#barbershop`,
  name: business.legalName,
  alternateName: business.name,
  slogan: business.tagline,
  image: ogImageUrl,
  url: site,
  telephone: business.phoneRaw,
  priceRange: '€8–€17',
  currenciesAccepted: 'EUR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address,
    addressLocality: business.town,
    addressRegion: business.province,
    postalCode: business.postalCode,
    addressCountry: 'ES',
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.lat, longitude: business.lng },
  hasMap: `https://www.google.com/maps/place/?q=place_id:${business.placeId}`,
  openingHoursSpecification: openingHours,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: String(business.reviewCount),
    bestRating: '5',
  },
  review: reviews.slice(0, 4).map((r) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.author },
    datePublished: r.date,
    reviewBody: r.quote,
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
  })),
  makesOffer: services
    .filter((s) => s.price)
    .map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name },
      price: s.price,
      priceCurrency: 'EUR',
    })),
  potentialAction: {
    '@type': 'ReserveAction',
    target: { '@type': 'EntryPoint', urlTemplate: business.booksyUrl },
  },
  // TikTok is abandoned and Facebook does not exist: linking them would be a lie.
  sameAs: [business.instagramUrl, business.booksyProfileUrl],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Only the display face is preloaded; body text can swap with matched metrics. -->
    <link rel="preload" as="image" href="/img/hero-poster.avif" fetchpriority="high" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={cinzelWoff} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F0F14" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

    <meta name="geo.region" content="ES-AN" />
    <meta name="geo.placename" content="Berja, Almería, España" />
    <meta name="geo.position" content={`${business.lat};${business.lng}`} />
    <meta name="ICBM" content={`${business.lat}, ${business.lng}`} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.name} — Berja, Almería`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>

  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:border focus:border-cal-dim focus:bg-marmol focus:px-4 focus:py-2 focus:font-body focus:text-cap focus:uppercase focus:text-cal"
      >Saltar al contenido</a
    >
    <slot />

    <script>
      // Motion is an enhancement, never a dependency: loaded after first paint
      // and only where it earns its 44 KB. If this never runs, the page is
      // already complete.
      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const load = () => import('../scripts/motion.js');
        if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
        else window.addEventListener('load', load);
      }
    </script>
  </body>
</html>
