---
/**
 * LocalTour — the shop, walked by scrolling.
 *
 * Every sharp frame of the client's 4K walkthrough — all 216, at the real
 * 24 fps cadence, nothing skipped and nothing blended — painted to a <canvas>
 * as the page scrolls. Scrubbing a <video> is unreliable on iOS and laggy
 * everywhere; a frame sequence is exact on every device.
 *
 * Fluidity rules learned the hard way:
 *  - Never cross-fade stills: when the camera moves between two frames the
 *    blend shows two rooms at once. Fluidity comes from frame density.
 *  - Frames are decoded (img.decode()) before they are ever drawn, so drawing
 *    never stalls on decoding.
 *  - On touch, a light ease absorbs native scroll bumps. On fine pointers
 *    Lenis already smooths the wheel — keep tour ease near-1:1 so frames
 *    do not lag behind a second softener.
 *  - Load a dense window around the scrub head first; never coarse-to-fine
 *    globally (that paints every-Nth frame and feels like a slideshow).
 *
 * Phones get 660x1173 AVIF (~6.8 MB for the whole walk); desktop gets a
 * pre-cropped panel (~6.6 MB). Frame 0 is a real <img> (the desktop LCP; on
 * phones it fills the viewport, which Chrome treats as background, so the
 * chapter title is the LCP). The rest stream from the scrub head outward
 * once the page has loaded; the canvas only shows once the walk moves.
 *
 * Chapters carry a fact for that stretch of the walk: the street, the room,
 * the price, who cuts. They do not caption the furniture.
 */
import { business } from '../data/content.js';
import Logo from './Logo.astro';

const FRAMES = 216;
const chapters = [
  { at: 0.0, kicker: 'Avenida José Barrionuevo Peña 14', title: 'Barbería en Berja', body: `${business.rating} ★ · ${business.reviewCount} reseñas verificadas en Booksy` },
  { at: 0.28, kicker: 'El salón', title: 'Lamas de roble', body: 'Un sillón. La calle, en el espejo.' },
  { at: 0.55, kicker: 'La cita', title: 'Desde 13 €', body: '30 minutos. Corte y barba, 17 €.' },
  { at: 0.8, kicker: 'Azedin, Samir y Anas', title: 'El barbero', body: 'Lo eliges al reservar.' },
];
---

<section
  id="hero"
  class="tour relative"
  aria-labelledby="hero-title"
  data-tour
  data-frames={FRAMES}
>
  <!-- Reserve the walk's scroll length before the first layout, under the
       same conditions the tour script runs in. Growing the section later
       (when the script starts) re-laid-out the whole page, moved the reel's
       pin after it was measured, and left the gallery within lazy-load
       distance of the first screen, so its images competed with the hero.
       Without JS the section stays one screen tall. -->
  <script is:inline>
    (function (s) {
      try {
        var c = navigator.connection;
        if (matchMedia('(prefers-reduced-motion: no-preference)').matches && !(c && c.saveData)) s.classList.add('is-tall');
      } catch (e) {}
    })(document.currentScript.parentElement);
  </script>
  <div class="tour-stage sticky top-0 h-[100svh] overflow-hidden bg-marmol">
    <!-- The walk. Phones: full-bleed (the footage is vertical, like the
         screen). Desktop: a vertical panel on the right at native resolution,
         never stretched across a landscape screen. -->
    <div class="tour-media absolute inset-0 md:inset-auto md:bottom-0 md:right-0 md:top-0 md:h-full md:w-[56vw]">
      <picture>
        <source media="(min-width: 768px)" type="image/avif" srcset="/tour/d/000.avif" />
        <source media="(min-width: 768px)" srcset="/tour/d/000.webp" />
        <source type="image/avif" srcset="/tour/m/000.avif" />
        <img
          src="/tour/m/000.webp"
          alt="Interior de Barbería Azedin en Berja: sillones, pared de listones de madera y suelo de mármol negro"
          width="660"
          height="1173"
          fetchpriority="high"
          decoding="async"
          class="tour-poster absolute inset-0 h-full w-full object-cover object-[50%_35%]"
        />
      </picture>
      <canvas class="tour-canvas absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
      <!-- Desktop: the panel's left edge dissolves into the marble. -->
      <div class="pointer-events-none absolute inset-y-0 left-0 hidden w-2/5 bg-gradient-to-r from-marmol via-marmol/60 to-transparent md:block" aria-hidden="true"></div>
    </div>

    <!-- Phones: a short solid floor under the copy. The room stays visible above it. -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[46%] bg-gradient-to-t from-marmol from-25% via-marmol/85 to-transparent md:hidden" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-marmol via-marmol/70 to-transparent md:hidden" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 hidden h-40 bg-gradient-to-b from-marmol via-marmol/80 to-transparent md:block" aria-hidden="true"></div>

    <!-- pt-24 keeps the logo clear of the fixed header on short screens. -->
    <div class="frame relative flex h-full flex-col justify-end pb-[max(2.5rem,env(safe-area-inset-bottom))] pt-24 md:justify-center md:pb-0">
      <div class="md:max-w-[min(46vw,560px)]">
        <h1 id="hero-title" class="m-0">
          <span class="sr-only">{business.legalName}, barbería en Berja</span>
          <Logo class="h-auto w-[min(46vw,440px)] text-cal" data-logo />
        </h1>

        <!-- Chapters: stacked in one grid cell, swapped by scroll position. -->
        <div class="mt-8 grid min-h-[7.5rem] md:mt-12 md:min-h-[8.5rem]">
          {
            chapters.map((c, i) => (
              <div
                class="tour-chapter col-start-1 row-start-1"
                data-at={c.at}
                style={i === 0 ? '' : 'opacity:0'}
                aria-hidden={i === 0 ? undefined : 'true'}
              >
                <p class="eyebrow text-cal">{c.kicker}</p>
                <p class="display mt-3 text-h3">{c.title}</p>
                <p class="mt-3 text-cal">{c.body}</p>
              </div>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4 md:mt-12">
          <a class="btn btn-primary" href={business.booksyUrl} target="_blank" rel="noopener noreferrer">
            Reservar
          </a>
          <div class="flex items-center gap-3" aria-hidden="true">
            <span class="eyebrow text-cal">Recorre el local</span>
            <span class="relative block h-px w-24 bg-veta">
              <span class="tour-progress absolute inset-y-0 left-0 block w-full origin-left scale-x-0 bg-roble"></span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Scroll length of the walk. Without JS the section is one screen tall
     and frame 0 stands as a photograph. */
  /* Phones: ~3.2 screens. One frame every ~12px is still a walk, not a slideshow.
     Desktop keeps the long scrub, about one frame per 16px. */
  .tour.is-tall {
    height: 320svh;
  }
  @media (min-width: 768px) {
    .tour.is-tall {
      height: 650svh;
    }
  }
  /* The canvas stays hidden while the poster <img> already shows frame 0:
     painting that same frame again would cost a main-thread decode during
     load for no visible change. It shows once the walk moves. */
  .tour-canvas {
    opacity: 0;
  }
  .tour.is-live .tour-canvas.is-painted {
    opacity: 1;
  }
  .tour-chapter {
    transition: opacity 420ms var(--ease-led);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-tour]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;

  // The whole tour is set up on idle, after the first paint, so none of it
  // lands in the module's own task. Until then the poster <img> is frame 0.
  if (root && !reduced && !saveData) {
    if ('requestIdleCallback' in window) requestIdleCallback(() => tour(root), { timeout: 800 });
    else window.addEventListener('load', () => tour(root), { once: true });
  }

  function tour(root: HTMLElement) {
    // Slow cellular or a low-memory device: only the window around the scrub
    // head is fetched, never the whole walk in the background.
    const constrained =
      ['slow-2g', '2g', '3g'].includes((navigator as any).connection?.effectiveType) ||
      ((navigator as any).deviceMemory ?? 8) <= 2;
    const N = Number(root.dataset.frames);
    const canvas = root.querySelector<HTMLCanvasElement>('.tour-canvas')!;
    // desynchronized: prefer low-latency paints while scrubbing; fall back if unsupported.
    const ctx =
      canvas.getContext('2d', { alpha: false, desynchronized: true, colorSpace: 'srgb' } as CanvasRenderingContext2DSettings) ||
      canvas.getContext('2d', { alpha: false })!;
    const chapters = [...root.querySelectorAll<HTMLElement>('.tour-chapter')];
    const progressBar = root.querySelector<HTMLElement>('.tour-progress');
    const desktop = window.matchMedia('(min-width: 768px)').matches;
    // Fine pointer + Lenis already softens wheel; keep tour nearly 1:1.
    // Touch keeps a short ease so native scroll bumps do not strobe frames.
    const finePointer = window.matchMedia('(pointer: fine)').matches;
    const easeTau = finePointer ? 0.028 : 0.055;
    const dir = desktop ? 'd' : 'm';
    const frames: (HTMLImageElement | null)[] = new Array(N).fill(null);
    const loading = new Set<number>();
    const WINDOW = 24; // dense neighborhood around the scrub head

    const src = (i: number) => `/tour/${dir}/${String(i).padStart(3, '0')}.avif`;

    // The backing store never holds more pixels than the frames carry: past
    // the source resolution a bigger canvas only upscales (the compositor does
    // that for free) while every drawImage pays for each extra pixel. On a
    // 3x phone this is ~3x fewer pixels per scrubbed frame, with no lost detail.
    function size() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2.5);
      const r = canvas.getBoundingClientRect();
      const f0 = frames[0];
      const native = f0 ? Math.max(1, 1 / Math.max(r.width / f0.naturalWidth, r.height / f0.naturalHeight)) : dpr;
      const scale = Math.min(dpr, native);
      const w = Math.round(r.width * scale);
      const h = Math.round(r.height * scale);
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      drawn = -1;
      paint(shown);
    }

    // object-fit: cover. Desktop frames are pre-cropped to the panel, so this
    // is near 1:1 there; phones bias the crop upward to keep the ceiling.
    function draw(img: HTMLImageElement) {
      const cw = canvas.width, ch = canvas.height;
      const s = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
      const w = img.naturalWidth * s, h = img.naturalHeight * s;
      ctx.drawImage(img, (cw - w) / 2, (ch - h) * (desktop ? 0.5 : 0.35), w, h);
    }

    function nearestLoaded(i: number) {
      for (let d = 0; d < N; d++) {
        if (frames[i - d]) return i - d;
        if (frames[i + d]) return i + d;
      }
      return -1;
    }

    // The sticky stage is 100svh (the SMALL viewport, stable while the
    // address bar slides). Measuring travel against the stage height instead
    // of window.innerHeight (which changes as the bar hides) keeps progress
    // from jumping mid-swipe on phones.
    const stage = root.querySelector<HTMLElement>('.tour-stage')!;
    function progressAt() {
      const r = root.getBoundingClientRect();
      const travel = r.height - stage.offsetHeight;
      return travel > 0 ? Math.min(1, Math.max(0, -r.top / travel)) : 0;
    }

    let shown = 0;   // eased progress actually painted
    let target = 0;  // progress the scroll asks for
    let drawn = -1;  // index of the frame on the canvas
    let painted = false; // canvas visible (it covers the poster)
    let activeChapter = -1;
    let raf = 0;
    let lastT = 0;
    let priorityHead = 0;

    function paint(p: number) {
      const want = Math.round(p * (N - 1));
      const i = frames[want] ? want : nearestLoaded(want);
      // Frame 0 is what the poster already shows: leave the canvas hidden
      // until the walk actually moves.
      if (i >= 0 && i !== drawn && (painted || i !== 0)) {
        draw(frames[i]!);
        drawn = i;
        if (!painted) {
          painted = true;
          canvas.classList.add('is-painted');
        }
      }
      if (progressBar) progressBar.style.transform = `scaleX(${p})`;
      let active = 0;
      chapters.forEach((c, k) => { if (p >= Number(c.dataset.at)) active = k; });
      if (active !== activeChapter) {
        activeChapter = active;
        chapters.forEach((c, k) => {
          c.style.opacity = k === active ? '1' : '0';
          if (k === active) c.removeAttribute('aria-hidden');
          else c.setAttribute('aria-hidden', 'true');
        });
      }
    }

    function tick(t: number) {
      const dt = lastT ? Math.min(0.05, (t - lastT) / 1000) : 1 / 60;
      lastT = t;
      shown += (target - shown) * (1 - Math.exp(-dt / easeTau));
      if (Math.abs(target - shown) < 1 / (N * 6)) shown = target;
      paint(shown);
      if (shown !== target) raf = requestAnimationFrame(tick);
      else { raf = 0; lastT = 0; }
    }

    function onScroll() {
      target = progressAt();
      priorityHead = Math.round(target * (N - 1));
      started = true;
      bumpPriority();
      scrolled = true;
      tryBulk();
      if (!raf) raf = requestAnimationFrame(tick);
    }

    // Priority queue + loader state — declared before load() so increments are safe.
    let queue: number[] = [];
    let queuedHead = -999;
    let loadedCount = 0;
    let pumping = false;
    // The first window waits for window load (or the first scroll): until
    // then the page's own images and fonts have the connection.
    let started = false;
    // Bulk = queue every frame, not just the window. Stays off on constrained
    // connections; otherwise it flips on after load + first scroll or a delay.
    let bulk = false;
    let scrolled = false;
    let bulkDelayDone = false;

    function tryBulk() {
      if (bulk || constrained || document.readyState !== 'complete') return;
      if (!scrolled && !bulkDelayDone) return;
      bulk = true;
      rebuildQueue(priorityHead);
      queuedHead = priorityHead;
      void ensurePump();
    }

    // Decode off the critical path before a frame is ever drawn.
    async function load(i: number) {
      if (i < 0 || i >= N || frames[i] || loading.has(i)) return;
      loading.add(i);
      const img = new Image();
      img.decoding = 'async';
      img.src = src(i);
      try {
        await img.decode();
      } catch {
        loading.delete(i);
        return;
      }
      frames[i] = img;
      loading.delete(i);
      loadedCount += 1;
      const want = Math.round(shown * (N - 1));
      if (drawn < 0 || Math.abs(i - want) <= Math.abs(drawn - want)) {
        drawn = -1;
        paint(shown);
      }
    }

    function rebuildQueue(head: number) {
      const ordered: number[] = [];
      const seen = new Set<number>();
      const push = (i: number) => {
        if (i < 0 || i >= N || seen.has(i) || frames[i]) return;
        seen.add(i);
        ordered.push(i);
      };
      // Immediate neighborhood first (forward + backward interleaved).
      for (let d = 0; d <= WINDOW; d++) {
        push(head + d);
        if (d) push(head - d);
      }
      // Then every remaining frame by distance from head (bulk only).
      if (!bulk) { queue = ordered; return; }
      const rest: number[] = [];
      for (let i = 0; i < N; i++) if (!seen.has(i) && !frames[i]) rest.push(i);
      rest.sort((a, b) => Math.abs(a - head) - Math.abs(b - head));
      queue = ordered.concat(rest);
    }

    function bumpPriority() {
      // Rebuild only when the scrub head moves ≥2 frames — every scroll
      // event would otherwise re-sort 216 indices and thrash the workers.
      if (Math.abs(priorityHead - queuedHead) < 2) return;
      queuedHead = priorityHead;
      rebuildQueue(priorityHead);
      void ensurePump();
    }

    async function ensurePump() {
      if (!started || pumping || loadedCount >= N) return;
      pumping = true;
      const workers = desktop ? 8 : 5;
      await Promise.all(
        Array.from({ length: workers }, async () => {
          while (loadedCount < N) {
            const next = queue.shift();
            if (next === undefined) {
              // Queue drained — wait for a priority bump or finish. Outside
              // bulk mode the window is all there is, so stop until re-bumped.
              if (!bulk || loadedCount + loading.size >= N) return;
              await new Promise((r) => setTimeout(r, 24));
              continue;
            }
            await load(next);
          }
        }),
      );
      pumping = false;
      // A bump may have refilled while we were winding down.
      if (loadedCount < N && queue.length) void ensurePump();
    }

    async function start() {
      // Frame 0 doubles as the AVIF support test: if it cannot be decoded,
      // the still photograph stays and nothing else is downloaded. It is the
      // poster's own file, so this is a cache hit.
      await load(0);
      if (!frames[0]) {
        // Give the scroll length back; let pinned sections re-measure.
        root.classList.remove('is-tall');
        window.dispatchEvent(new Event('resize'));
        return;
      }
      root.classList.add('is-tall', 'is-live');
      shown = target = progressAt();
      priorityHead = Math.round(shown * (N - 1));
      size();
      window.addEventListener('scroll', onScroll, { passive: true });
      // Only real resizes (width change / rotation) re-measure the canvas;
      // address-bar height changes do not, to avoid re-allocating it mid-swipe.
      let lastW = window.innerWidth;
      window.addEventListener('resize', () => {
        if (window.innerWidth !== lastW) { lastW = window.innerWidth; size(); }
      });

      rebuildQueue(priorityHead);
      queuedHead = priorityHead;

      // The first window starts after window load (or on the first scroll);
      // bulk download after load, then first scroll or 3.5 s.
      const afterLoad = () => {
        started = true;
        void ensurePump();
        setTimeout(() => { bulkDelayDone = true; tryBulk(); }, 3500);
        tryBulk();
      };
      if (document.readyState === 'complete') afterLoad();
      else window.addEventListener('load', afterLoad, { once: true });
      // Arrived mid-walk (reload, back/forward): that stretch is needed now.
      if (priorityHead > 0) onScroll();
    }

    void start();
  }
</script>
