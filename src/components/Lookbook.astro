---
/**
 * Archivo — the cuts, still, large enough to judge.
 *
 * The tour is the only motion on the page. A pinned reel dimmed every
 * photo except one. Here each cut is full brightness. The two clips
 * stay as their poster; nothing plays.
 */
import { Image } from 'astro:assets';
import { galleryItems, business } from '../data/content.js';
---

<section id="archivo" class="relative py-20 md:py-30" aria-labelledby="archivo-title">
  <div class="frame">
    <header class="ruled-bottom flex flex-wrap items-end justify-between gap-6 pb-8">
      <div>
        <p class="eyebrow mb-3">Trabajos recientes</p>
        <h2 id="archivo-title" class="text-sect display">Archivo</h2>
      </div>
      <a
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 font-body text-cap font-semibold uppercase tracking-wide text-humo transition-colors duration-120 hover:text-cal"
      >
        Más en Instagram <span class="text-roble">→</span>
      </a>
    </header>

    <ul class="mt-10 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        galleryItems.map((item, i) => (
          <li class="archivo-card">
            <figure>
              <div class="relative aspect-card overflow-hidden border border-veta bg-marmol-2">
                {item.video ? (
                  <img
                    src={item.poster}
                    alt={item.alt}
                    width="720"
                    height="1280"
                    loading="lazy"
                    decoding="async"
                    style="object-position: center 30%"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <Image
                    src={item.src}
                    alt={item.alt}
                    width={1200}
                    height={1600}
                    widths={[640, 960, 1200]}
                    sizes="(min-width: 1024px) 28vw, (min-width: 640px) 46vw, 92vw"
                    format="avif"
                    quality={78}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    style={`object-position: ${item.focus}`}
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                )}
              </div>
              <figcaption class="mt-4 flex items-baseline justify-between gap-3">
                <span class="font-display text-cap font-semibold uppercase tracking-wide text-cal">{item.label}</span>
                <span class="font-body text-cap text-humo">{item.barber}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
