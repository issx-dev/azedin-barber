---
/**
 * Archivo — the work, as a reel you scroll through.
 *
 * One pinned horizontal rail on EVERY breakpoint (the previous version
 * collapsed to a grid on phones, and the pin never ran there). On phones each
 * card is ~78vw, so one cut fills the screen and the next peeks in.
 *
 * Six cuts, the ones sharp enough to judge. The card in the centre is on
 * the chair: full size, full light. Neighbours ease back to about half
 * brightness as they leave the centre, so the cut in front stays obvious
 * and the next one is still a cut, not a black rectangle.
 * Without JS the rail is a native horizontal scroller with snap points.
 */
import { Image } from 'astro:assets';
import { galleryItems, business } from '../data/content.js';

const total = String(galleryItems.length).padStart(2, '0');
---

<section id="archivo" class="relative" aria-labelledby="archivo-title" data-reel>
  <!-- Exactly one screen. A stage taller than the viewport is pinned flush
       with the top and then jumps up by the overflow when the pin lets go. -->
  <div class="reel-stage flex h-[100svh] max-h-[100svh] flex-col overflow-hidden bg-marmol pt-20 pb-6 md:justify-center md:py-0">
    <header class="frame flex items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-3">Trabajos recientes</p>
        <h2 id="archivo-title" class="text-sect display">Archivo</h2>
      </div>
      <p class="pb-1 font-display text-sub tabular text-humo" aria-hidden="true">
        <span class="reel-index text-cal">01</span> / {total}
      </p>
    </header>

    <!-- No-JS: native scroller with snap. With JS: driven by the page scroll. -->
    <div class="reel-viewport mt-6 min-h-0 flex-1 overflow-x-auto md:mt-12 md:flex-none" tabindex="0" aria-label="Galería de cortes, desplazable">
      <ul class="reel-rail relative flex h-full w-max gap-4 px-[11vw] md:h-auto md:gap-8 md:px-[calc(50vw-160px)]">
        {
          galleryItems.map((item, i) => (
            <li class="reel-card flex h-full w-[78vw] shrink-0 snap-center sm:w-[44vw] md:block md:h-auto md:w-[clamp(240px,22vw,320px)]" data-i={i}>
              <figure class="flex h-full min-h-0 w-full flex-col md:block md:h-auto">
                <div class="reel-media relative aspect-auto min-h-0 w-full flex-1 overflow-hidden border border-veta bg-marmol-2 md:aspect-reel md:flex-none">
                  {item.video ? (
                    <video
                      class="reel-video absolute inset-0 h-full w-full object-cover"
                      muted
                      loop
                      playsinline
                      preload="none"
                      poster={item.poster}
                      aria-label={item.alt}
                      data-src={item.video}
                    />
                  ) : (
                    <Image
                      src={item.src}
                      alt={item.alt}
                      width={1200}
                      height={2133}
                      widths={[640, 960, 1200]}
                      sizes="(min-width: 768px) 320px, 78vw"
                      format="avif"
                      quality={78}
                      loading={i < 3 ? 'eager' : 'lazy'}
                      style={`object-position: ${item.focus}`}
                      class="absolute inset-0 h-full w-full object-cover"
                    />
                  )}
                  {item.video && (
                    <span class="absolute left-3 top-3 border border-cal/30 bg-marmol/70 px-2 py-1 font-body text-[0.625rem] font-semibold uppercase tracking-wide text-cal">
                      Vídeo
                    </span>
                  )}
                </div>
                <figcaption class="mt-4 flex shrink-0 items-baseline justify-between gap-3">
                  <span class="font-display text-cap font-semibold uppercase tracking-wide text-cal">{item.label}</span>
                  <span class="font-body text-cap text-humo">{item.barber}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="frame mt-6 flex shrink-0 items-center justify-between gap-6 md:mt-12">
      <span class="relative block h-px flex-1 bg-veta" aria-hidden="true">
        <span class="reel-progress absolute inset-y-0 left-0 block w-full origin-left scale-x-0 bg-roble"></span>
      </span>
      <a
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 font-body text-cap font-semibold uppercase tracking-wide text-humo transition-colors duration-120 hover:text-cal"
      >
        Más en Instagram <span class="text-roble">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .reel-viewport {
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .reel-viewport::-webkit-scrollbar {
    display: none;
  }
  /* Driven by scroll: the viewport no longer scrolls natively. */
  [data-reel].is-live .reel-viewport {
    overflow: visible;
    scroll-snap-type: none;
  }
  .reel-card {
    transition:
      opacity 420ms var(--ease-led),
      transform 420ms var(--ease-marmol);
  }
  /* Resting pose before the first scroll frame. JS then drives scale and
     brightness from distance to the chair, every frame, so the CSS transition
     would only lag the finger. Captions stay undimmed (WCAG AA). */
  [data-reel].is-live .reel-card {
    transform: scale(0.9);
    transition: none;
  }
  [data-reel].is-live .reel-card .reel-media {
    filter: brightness(0.45) saturate(0.68);
    transition: none;
  }
  [data-reel].is-live .reel-card.is-on {
    transform: scale(1);
  }
  [data-reel].is-live .reel-card.is-on .reel-media {
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reel].is-live .reel-card {
      transform: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  // Mobile browsers resize the viewport when the address bar hides/shows.
  // Recomputing the pin on each of those mid-scroll makes the page jump.
  ScrollTrigger.config({ ignoreMobileResize: true });

  const root = document.querySelector<HTMLElement>('[data-reel]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) {
    const stage = root.querySelector<HTMLElement>('.reel-stage')!;
    const rail = root.querySelector<HTMLElement>('.reel-rail')!;
    const cards = [...root.querySelectorAll<HTMLElement>('.reel-card')];
    const indexEl = root.querySelector<HTMLElement>('.reel-index');
    const progress = root.querySelector<HTMLElement>('.reel-progress');
    let on = -1;

    // The focused card ("on the chair") follows progress through the rail, so
    // the first and last cuts get their turn too — a centre-distance test can
    // never select them because they cannot scroll to the centre.
    function focus(p?: number) {
      let best = 0;
      if (typeof p === 'number') {
        best = Math.round(p * (cards.length - 1));
      } else {
        const mid = window.innerWidth / 2;
        let bestD = Infinity;
        cards.forEach((c, i) => {
          const r = c.getBoundingClientRect();
          const d = Math.abs(r.left + r.width / 2 - mid);
          if (d < bestD) { bestD = d; best = i; }
        });
      }
      if (best === on) return;
      on = best;
      cards.forEach((c, i) => c.classList.toggle('is-on', i === best));
      if (indexEl) indexEl.textContent = String(best + 1).padStart(2, '0');
      // Only the focused video plays; the others pause and keep their poster.
      cards.forEach((c, i) => {
        const v = c.querySelector<HTMLVideoElement>('video');
        if (!v) return;
        if (i === best && !reduced) {
          if (!v.src) v.src = v.dataset.src!;
          v.play().catch(() => {});
        } else v.pause();
      });
    }

    if (reduced) {
      // Keep the native snap scroller; just track focus as the user swipes.
      root.querySelector('.reel-viewport')!.addEventListener('scroll', focus, { passive: true });
      focus();
    } else {
      root.classList.add('is-live');
      // Card centres in rail coordinates (offsetLeft is rail-relative: the
      // rail is `relative`). Untransformed layout, so CSS scale on the cards
      // never skews them.
      const centres = () => cards.map((c) => c.offsetLeft + c.offsetWidth / 2);
      // Rail x that puts screen-centre on rail-coordinate `cx`.
      // The rail's horizontal start inside the viewport. Its viewport box is
      // (layout left + current translateX); subtracting the translate gives
      // the layout left. Horizontal only, so pin state (fixed vs static,
      // which shifts vertical offsets) does not affect it.
      const railLeft = () => rail.getBoundingClientRect().left - (Number(gsap.getProperty(rail, 'x')) || 0);
      const xFor = (cx: number) => window.innerWidth / 2 - railLeft() - cx;

      // One card per STEP px of scroll. Phones need a real beat on each cut:
      // 180px blew six cuts past the chair before the eye could settle.
      // Desktop stays tied to the stage (100svh), not window.innerHeight,
      // which changes as a phone's address bar slides.
      const STEP = () => (window.innerWidth < 768 ? 360 : Math.min(420, Math.max(300, stage.offsetHeight * 0.4)));
      const travel = () => STEP() * (cards.length - 1);

      // Map progress -> rail x piecewise-linearly through the card centres,
      // so at progress k/(n-1) card k is exactly centred, whatever the widths
      // and gaps. A single linear tween drifted off by the gap ratio.
      const state = { p: 0 };
      // Neighbour falls to 0.9 scale and ~0.45 brightness. The value follows
      // the fractional index, so the handoff glides instead of popping.
      const pose = (f: number) => {
        cards.forEach((card, i) => {
          const fall = Math.min(1, Math.abs(i - f));
          card.style.transform = `scale(${(1 - fall * 0.1).toFixed(4)})`;
          const media = card.querySelector<HTMLElement>('.reel-media');
          if (!media) return;
          if (fall < 0.04) {
            media.style.filter = 'none';
          } else {
            const bright = (1 - fall * 0.55).toFixed(3);
            const sat = (1 - fall * 0.32).toFixed(3);
            media.style.filter = `brightness(${bright}) saturate(${sat})`;
          }
        });
      };
      const apply = () => {
        const c = centres();
        const f = state.p * (cards.length - 1);
        const k = Math.min(cards.length - 2, Math.floor(f));
        const t = f - k;
        const cx = c[k] + (c[k + 1] - c[k]) * t;
        gsap.set(rail, { x: xFor(cx) });
        if (progress) progress.style.transform = `scaleX(${state.p})`;
        pose(f);
        focus(state.p);
      };

      gsap.to(state, {
        p: 1,
        ease: 'none',
        onUpdate: apply,
        scrollTrigger: {
          trigger: root,
          pin: stage,
          start: 'top top',
          end: () => '+=' + travel(),
          // No `snap`: it scrolls the window while a thumb is still driving
          // it, and the two fought — that was the mobile breakage.
          scrub: 0.5,
          invalidateOnRefresh: true,
          // No anticipatePin: a flick pinned this panel over Precios while
          // the stage was still transparent, so the two sections painted together.
          onRefresh: apply,
        },
      });
      apply();
      document.fonts?.ready.then(() => ScrollTrigger.refresh());
      window.addEventListener('load', () => ScrollTrigger.refresh(), { once: true });
    }
  }
</script>
