---
/**
 * InstagramStrip — Photo grid + permanent social row (IG + TikTok).
 *
 * Plan v2 (Sección 5): heading added, hover-only overlay removed,
 * permanent social icon row below the grid works on touch devices.
 * Brand logos from react-icons/si (Simple Icons) — real IG/TikTok glyphs,
 * not hand-drawn SVG.
 */
import { Image } from 'astro:assets';
import { business } from '../data/content.js';

import img1 from '../assets/img/corte-skin-fade-degradado.jpeg';
import img2 from '../assets/img/corte-arreglo-barba-perfilado.jpeg';
import img3 from '../assets/img/corte-crop-top-texturizado.jpeg';
import img4 from '../assets/img/corte-low-fade-degradado-bajo.jpeg';
import img5 from '../assets/img/corte-afeitado-clasico-navaja.jpeg';
import img6 from '../assets/img/corte-mid-fade-degradado-medio.jpeg';

const photos = [
  { src: img1, alt: "Skin fade degradado" },
  { src: img2, alt: "Arreglo barba perfilado" },
  { src: img3, alt: "Crop top texturizado" },
  { src: img4, alt: "Low fade degradado" },
  { src: img5, alt: "Afeitado clásico" },
  { src: img6, alt: "Mid fade degradado" },
];
---

<section
  id="social"
  class="bg-bg-deep pb-16 md:pb-24"
  aria-label="Galería de Instagram y redes sociales de Azedin Barber"
>
  <!-- Section header -->
  <div class="px-6 md:px-10 max-w-6xl mx-auto pt-24 md:pt-28 pb-12">
    <p
      data-fade
      class="text-[13px] md:text-[14.5px] tracking-[0.15em] uppercase text-ink-dim font-medium mb-4"
    >
      Síguenos
    </p>
    <h2
      data-reveal
      class="font-display display-large text-cream"
    >
      Mira lo que hacemos
    </h2>
  </div>

  <!-- Photo grid — 2 cols mobile, 3 tablet, 6 desktop -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-0 w-full overflow-hidden" data-fade>
    {photos.map((photo) => (
      <a
        href={business.instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="relative block aspect-[4/5] overflow-hidden group"
        aria-label={`Ver foto de ${photo.alt} en Instagram`}
      >
        <Image
          src={photo.src}
          alt={photo.alt}
          width={400}
          height={500}
          format="avif"
          quality={82}
          loading="lazy"
          class="w-full h-full object-cover photo-preset transition-transform duration-300 ease-out group-hover:scale-105"
        />
        <div class="absolute top-3 right-3 w-8 h-8 rounded-full bg-bg-deep/70 backdrop-blur-sm border border-white/10 flex items-center justify-center text-cream/80 opacity-70 group-hover:opacity-100 transition-opacity">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>