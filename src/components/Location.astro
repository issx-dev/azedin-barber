---
/**
 * Location — "Dónde".
 *
 * Static map image plus a link, never an embedded iframe: a Maps iframe in the
 * critical path is one of the most expensive things you can put on a local
 * business page. Opening hours are the most-consulted content on a barbershop
 * site, so the irregular days (Monday afternoon only, short Saturday) are
 * called out instead of being flattened into a range.
 */
import { business, hours } from '../data/content.js';

const mapsUrl = `https://www.google.com/maps/place/?q=place_id:${business.placeId}`;
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.lat},${business.lng}&destination_place_id=${business.placeId}`;
---

<section id="donde" class="relative py-20 md:py-30" aria-labelledby="donde-title">
  <div class="frame">
    <header class="ruled-bottom pb-8">
      <p class="eyebrow mb-4">{business.plusCode}</p>
      <h2 id="donde-title" class="text-sect uppercase text-caliza">Dónde</h2>
    </header>

    <div class="grid gap-x-10 gap-y-12 pt-10 lg:grid-cols-12">
      <!-- Hours: the docket again, with the exceptions made explicit. -->
      <div class="lg:col-span-5">
        <p class="eyebrow mb-5">Horario</p>
        <dl>
          {
            hours.map((h) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-lead-lo py-3">
                <dt class="font-mono text-cap uppercase tracking-wide text-caliza">{h.day}</dt>
                <dd class="text-right font-mono text-cap tabular text-lead">
                  {h.slots.length ? h.slots.join(' · ') : 'Cerrado'}
                  {/* The note only adds information when there are hours to
                      qualify; on Sunday it would just repeat "Cerrado". */}
                  {h.note && h.slots.length > 0 && <span class="ml-2 text-gules-hi">{h.note}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="lg:col-span-4">
        <p class="eyebrow mb-5">Dirección</p>
        <address class="not-italic">
          <p class="font-display uppercase text-caliza" style="font-size: var(--step-1); font-variation-settings: 'wght' 600, 'wdth' 100;">
            {business.address}
          </p>
          <p class="mt-2 font-mono text-cap text-lead">
            {business.postalCode} {business.town}, {business.province}
          </p>
          <p class="mt-5">
            <a
              href={`tel:${business.phoneRaw}`}
              class="font-mono tabular text-caliza underline decoration-lead-lo underline-offset-4 transition-colors duration-150 ease-plomo hover:decoration-gules"
            >
              {business.phone}
            </a>
          </p>
        </address>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar</a>
          <a class="btn btn-primary" href={business.booksyUrl} target="_blank" rel="noopener noreferrer">Reservar</a>
        </div>
      </div>

      <div class="lg:col-span-3">
        <p class="eyebrow mb-5">En Berja</p>
        <a
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group block border border-lead-lo p-5 transition-colors duration-250 ease-plomo hover:border-caliza"
        >
          <p class="font-mono text-cap tabular text-lead">
            {business.lat.toFixed(5)}<br />{business.lng.toFixed(5)}
          </p>
          <p class="mt-6 font-mono text-cap uppercase tracking-wide text-caliza">
            Ver en Google Maps <span class="text-gules">→</span>
          </p>
        </a>
      </div>
    </div>
  </div>
</section>
