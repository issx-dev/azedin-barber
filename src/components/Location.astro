---
/**
 * Location — "Dónde".
 *
 * Static map image plus a link, never an embedded iframe: a Maps iframe in the
 * critical path is one of the most expensive things you can put on a local
 * business page. Opening hours are the most-consulted content on a barbershop
 * site, so the irregular day (Monday afternoon only) is called out instead
 * of being flattened into a range.
 */
import { business, hours } from '../data/content.js';

const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${business.lat},${business.lng}&destination_place_id=${business.placeId}`;
---

<section id="donde" class="section relative" aria-labelledby="donde-title">
  <div class="frame">
    <header class="section-head ruled-bottom">
      <p class="eyebrow mb-4">{business.town}, {business.province}</p>
      <h2 id="donde-title" class="text-sect display text-cal">Dónde</h2>
    </header>

    <div class="section-body grid gap-x-16 gap-y-12 lg:grid-cols-12">
      <!-- Hours: the docket again, with the exceptions made explicit. -->
      <div class="lg:col-span-6" data-open-hours data-hours={JSON.stringify(hours)}>
        <p class="eyebrow mb-5">Horario</p>
        {/* Live status, filled in the browser (Europe/Madrid). Hidden until
            then: without JS the weekly hours below are the whole truth. */}
        <p data-open-status role="status" class="mb-4 hidden items-center gap-3 font-body text-base text-cal">
          <span data-open-dot class="h-2 w-2 shrink-0 rounded-full bg-humo" aria-hidden="true"></span>
          <span data-open-label></span>
        </p>
        <dl>
          {
            hours.map((h) => (
              <div data-day={h.day} class="hours-row flex items-baseline justify-between gap-4 border-b border-veta py-3">
                <dt class="font-body text-cap uppercase tracking-wide text-cal">{h.day}</dt>
                <dd class="text-right font-body text-cap tabular text-humo">
                  {h.slots.length ? h.slots.join(' · ') : 'Cerrado'}
                  {/* The note only adds information when there are hours to
                      qualify; on Sunday it would just repeat "Cerrado". */}
                  {h.note && h.slots.length > 0 && <span class="ml-2 text-roble-hi">{h.note}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Address: the other half of the frame. A hairline echoes the reviews
           divider; the street is set a step larger so it carries the column,
           and phone + directions sit on the floor, level with Domingo. -->
      <div class="flex flex-col lg:col-span-6 lg:border-l lg:border-veta lg:pl-16">
        <p class="eyebrow mb-5">Dirección</p>
        <address class="flex flex-1 flex-col not-italic">
          <p class="font-display uppercase text-cal" style="font-size: var(--step-2); line-height: 1.1; font-variation-settings: 'wght' 600; max-width: 16ch;">
            {business.address}
          </p>
          <p class="mt-3 font-body text-cap text-humo">
            {business.postalCode} {business.town}, {business.province}
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-veta pt-5 lg:mt-auto">
            <a
              href={`tel:${business.phoneRaw}`}
              class="inline-flex min-h-[44px] items-center py-3 font-body tabular text-cal underline decoration-veta underline-offset-4 transition-colors duration-120 ease-marmol hover:decoration-roble"
            >
              {business.phone}
            </a>
            <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener noreferrer">Cómo llegar</a>
          </div>
        </address>
      </div>
    </div>
  </div>
</section>

<style>
  /* Today's row: full-strength text and a short oak rule before the day,
     the same hairline language as the ledger. Set by the script below. */
  .hours-row[data-today] dt,
  .hours-row[data-today] dd {
    color: #ececea;
  }
  .hours-row[data-today] dt::before {
    content: '';
    display: inline-block;
    width: 12px;
    height: 1px;
    margin-right: 0.6em;
    vertical-align: middle;
    background: #b3a98f;
  }
</style>

<script>
  import { getOpenStatus, everyMinute } from '../scripts/open-status.js';

  const box = document.querySelector<HTMLElement>('[data-open-hours]');
  if (box) {
    try {
      const hours = JSON.parse(box.dataset.hours ?? '[]');
      const line = box.querySelector<HTMLElement>('[data-open-status]')!;
      const dot = box.querySelector<HTMLElement>('[data-open-dot]')!;
      const label = box.querySelector<HTMLElement>('[data-open-label]')!;
      const rows = [...box.querySelectorAll<HTMLElement>('[data-day]')];

      everyMinute(() => {
        const s = getOpenStatus(hours, new Date());
        if (label.textContent !== s.label) label.textContent = s.label;
        dot.classList.toggle('bg-salvia', s.open);
        dot.classList.toggle('bg-humo', !s.open);
        line.classList.replace('hidden', 'flex');
        rows.forEach((r) => r.toggleAttribute('data-today', r.dataset.day === s.dayName));
      });
    } catch {}
  }
</script>
