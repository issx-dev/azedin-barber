---
import { business } from '../data/content.js';

export interface Props {
  logoSrc?: string;
}

const { logoSrc } = Astro.props;

const anchors = [
  { href: '#lookbook',  label: 'Lookbook'  },
  { href: '#servicios', label: 'Servicios' },
  { href: '#reseñas',   label: 'Reseñas'   },
  { href: '#ubicacion', label: 'Ubicación' },
];
---

<div
  id="mobile-nav"
  class="fixed inset-0 z-[300] pointer-events-none transition-all duration-200"
  inert
>
  <!-- Backdrop -->
  <div
    id="mobile-nav-backdrop"
    class="absolute inset-0 opacity-0 transition-opacity duration-250 ease-out cursor-pointer"
    style="background-color: rgba(12,10,9,0.92); backdrop-filter: blur(12px);"
    aria-hidden="true"
  ></div>

  <!-- Panel -->
  <div
    id="mobile-nav-dialog"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
    class="absolute inset-0 flex flex-col bg-transparent translate-x-full transition-transform duration-300"
    style="transition-timing-function: cubic-bezier(0.32, 0.72, 0, 1);"
  >
    <!-- Header: Logo + Close -->
    <div class="flex items-center justify-between px-6 h-[68px]">
      {logoSrc && (
        <img
          src={logoSrc}
          alt="Azedin Barber"
          width="500"
          height="333"
          class="w-[100px] h-auto invert opacity-[0.94]"
        />
      )}
      <button
        id="mobile-nav-close"
        type="button"
        aria-label="Cerrar menú"
        class="flex items-center justify-center w-[44px] h-[44px] text-cream hover:text-oak transition-colors duration-200 bg-transparent border-none cursor-pointer"
      >
        <span class="text-xl leading-none" aria-hidden="true">✕</span>
      </button>
    </div>

    <!-- Nav links — centered, staggered -->
    <nav
      class="flex-1 flex flex-col items-center justify-center gap-2"
      aria-label="Navegación principal"
    >
      {anchors.map((a, i) => (
        <a
          href={a.href}
          class="mobilenav-anchor-link mobilenav-stagger-item opacity-0 translate-y-4 transition-all duration-350 ease-out"
          style={`font-family: var(--font-display); font-size: clamp(2rem, 8vw, 3.5rem); font-weight: 700; text-decoration: none; letter-spacing: -0.02em; line-height: 1.1; padding-left: 1rem; transition-delay: ${80 + i * 60}ms;`}
        >
          {a.label}
        </a>
      ))}
    </nav>

    <!-- CTA bottom -->
    <div
      class="px-6 pb-12 flex flex-col gap-3 mobilenav-stagger-item opacity-0 translate-y-4 transition-all duration-350 ease-out"
      style="transition-delay: 360ms;"
    >
      <div class="w-full h-[1px] bg-border mb-[1.25rem]"></div>
      <!-- Social row — IG + TikTok -->
      <div class="flex items-center gap-3 mb-3">
        <a
          href={business.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sigue a Azedin Barber en Instagram"
          class="inline-flex items-center justify-center w-[2.75rem] h-[2.75rem] rounded-full border border-border-hi text-cream hover:text-oak transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <a
          href={business.tiktokUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sigue a Azedin Barber en TikTok"
          class="inline-flex items-center justify-center w-[2.75rem] h-[2.75rem] rounded-full border border-border-hi text-cream hover:text-oak transition-colors duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19.589 6.686a4.793 4.793 0 0 1-3.77-4.245V2h-3.445v13.672a2.896 2.896 0 0 1-5.201 1.743l-.002-.001a2.895 2.895 0 0 1 3.183-4.51v-3.5a6.329 6.329 0 0 0-5.394 2.193 6.34 6.34 0 0 0 1.077 8.916 6.344 6.344 0 0 0 8.784-1.874 6.331 6.331 0 0 0 .993-3.407V8.751a8.214 8.214 0 0 0 4.775 1.484V6.786a4.776 4.776 0 0 1-1.001-.1z"/>
          </svg>
        </a>
      </div>
      <a
        href={business.booksyAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-oak w-full justify-center text-[0.75rem] mobile-nav-booksy-btn"
        aria-label="Reservar cita en Booksy"
      >
        Reservar cita
      </a>
    </div>
  </div>
</div>

<style>
  .mobilenav-anchor-link {
    color: var(--color-cream);
  }
  .mobilenav-anchor-link:hover {
    color: var(--color-steel) !important;
  }
</style>

<script>
  (() => {
    const nav = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const dialog = document.getElementById('mobile-nav-dialog');
    const closeBtn = document.getElementById('mobile-nav-close');

    if (!nav || !backdrop || !dialog) return;

    let isOpen = false;

    const open = () => {
      if (isOpen) return;
      isOpen = true;
      nav.removeAttribute('inert');
      nav.style.pointerEvents = 'auto';
      backdrop.style.opacity = '1';
      dialog.style.transform = 'translateX(0)';
      document.body.style.overflow = 'hidden';

      // Stagger items
      const staggerItems = nav.querySelectorAll('.mobilenav-stagger-item');
      staggerItems.forEach(el => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'translateY(0)';
      });
    };

    const close = () => {
      if (!isOpen) return;
      isOpen = false;
      backdrop.style.opacity = '0';
      dialog.style.transform = 'translateX(100%)';
      document.body.style.overflow = '';

      const staggerItems = nav.querySelectorAll('.mobilenav-stagger-item');
      staggerItems.forEach(el => {
        (el as HTMLElement).style.opacity = '0';
        (el as HTMLElement).style.transform = 'translateY(16px)';
      });

      setTimeout(() => {
        if (!isOpen) {
          nav.setAttribute('inert', '');
          nav.style.pointerEvents = 'none';
        }
      }, 320);

      window.dispatchEvent(new CustomEvent('nav:close'));
    };

    window.addEventListener('nav:open', open);

    backdrop.addEventListener('click', close);
    closeBtn?.addEventListener('click', close);

    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', close);
    });

    window.addEventListener('keydown', (e) => {
      if (!isOpen) return;

      if (e.key === 'Escape') {
        close();
      } else if (e.key === 'Tab') {
        const focusables = dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
