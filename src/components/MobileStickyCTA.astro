---
/**
 * MobileStickyCTA — Floating bottom CTA, visible only on mobile.
 */
import { business } from '../data/content.js';
import CTA from './CTA.astro';
---
<div
  id="mobile-sticky-cta"
  class="fixed bottom-0 left-0 right-0 p-3.5 z-[90] md:hidden bg-bg-deep/95 backdrop-blur-md border-t border-steel/15 shadow-2xl transition-transform duration-300 ease-out pointer-events-none"
>
  <CTA href={business.booksyAppUrl} label="RESERVAR CITA ›" extraClass="w-full shadow-lg pointer-events-auto text-[11px] font-semibold tracking-[0.18em] py-3.5" />
</div>

<script>
  function initMobileCTA() {
    const cta = document.getElementById('mobile-sticky-cta');
    const hero = document.getElementById('hero');
    const locationSection = document.getElementById('ubicacion');

    if (cta && hero && locationSection) {
      if (window.innerWidth >= 768) return;

      let isPastHero = false;
      let isNearBottom = false;
      let rAFId: number | null = null;

      const updateCTA = () => {
        if (rAFId) cancelAnimationFrame(rAFId);
        rAFId = requestAnimationFrame(() => {
          if (isPastHero && !isNearBottom) {
            cta.classList.remove('translate-y-full');
          } else {
            cta.classList.add('translate-y-full');
          }
        });
      };

      const heroObserver = new IntersectionObserver((entries) => {
        isPastHero = !entries[0].isIntersecting;
        updateCTA();
      }, { rootMargin: '0px' });

      const locationObserver = new IntersectionObserver((entries) => {
        isNearBottom = entries[0].isIntersecting;
        updateCTA();
      }, { rootMargin: '600px 0px 0px 0px' });

      heroObserver.observe(hero);
      locationObserver.observe(locationSection);
    }
  }

  // Support Astro transitions and direct loads
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileCTA);
  } else {
    initMobileCTA();
  }
</script>
