---
/**
 * MobileStickyCTA — persistent booking bar on small screens.
 *
 * Shown after the tour, which already has the button. Hidden again over
 * the archivo, the reviews and the footer, where a bar would cover the
 * caption, the quote or the closing line. Hours keep it: that section no longer has its own button.
 */
import { business } from '../data/content.js';
---

<aside
  id="mobile-sticky-cta"
  aria-label="Reservar cita"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-veta bg-marmol/95 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] transition-transform duration-420 ease-led md:hidden motion-reduce:transition-none"
>
  <a
    class="btn btn-primary pointer-events-auto w-full"
    href={business.booksyUrl}
    target="_blank"
    rel="noopener noreferrer">Reservar · {business.rating} ★</a
  >
</aside>

<script>
  const cta = document.getElementById('mobile-sticky-cta');
  const tour = document.querySelector('[data-tour]');
  const quiet = ['#archivo', '#resenas', '#instagram', 'footer']
    .map((s) => document.querySelector(s))
    .filter(Boolean) as Element[];

  if (cta && tour && window.matchMedia('(max-width: 767px)').matches) {
    let inTour = true;
    const busy = new Set<Element>();
    const sync = () => cta.classList.toggle('translate-y-full', inTour || busy.size > 0);

    new IntersectionObserver(([e]) => {
      inTour = e.isIntersecting;
      sync();
    }).observe(tour);

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? busy.add(e.target) : busy.delete(e.target)));
      sync();
    }, { rootMargin: '0px 0px -20% 0px' });
    quiet.forEach((el) => io.observe(el));
  }
</script>
