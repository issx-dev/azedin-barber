---
/**
 * MobileStickyCTA — persistent booking bar on small screens.
 *
 * Appears once the hero is out of view and retracts near the footer, where the
 * big CTA already lives. Pattern from sublimestudio.dk, which keeps a floating
 * booking button through the whole scroll.
 */
import { business } from '../data/content.js';
---

<div
  id="mobile-sticky-cta"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-lead-lo bg-ink/95 p-3 transition-transform duration-400 ease-out-quart md:hidden motion-reduce:transition-none"
>
  <a
    class="btn btn-primary pointer-events-auto w-full"
    href={business.booksyUrl}
    target="_blank"
    rel="noopener noreferrer">Reservar cita · {business.rating} ★</a
  >
</div>

<script>
  const cta = document.getElementById('mobile-sticky-cta');
  const hero = document.getElementById('hero-title');
  const tail = document.getElementById('donde');

  if (cta && hero && window.matchMedia('(max-width: 767px)').matches) {
    let pastHero = false;
    let atTail = false;

    const sync = () => cta.classList.toggle('translate-y-full', !(pastHero && !atTail));

    new IntersectionObserver(([e]) => {
      pastHero = !e.isIntersecting;
      sync();
    }).observe(hero);

    if (tail) {
      new IntersectionObserver(
        ([e]) => {
          atTail = e.isIntersecting;
          sync();
        },
        { rootMargin: '400px 0px 0px 0px' }
      ).observe(tail);
    }
  }
</script>
