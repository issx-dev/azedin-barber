---
/**
 * Footer — Premium Editorial Footer.
 *
 * Bricolage Grotesque wordmark + 3-column architecture (Location, Hours, Links/Social)
 * + refined copyright row. Back to top is handled by floating BackToTop component.
 */
import { business } from '../data/content.js';
import SocialIcon from './SocialIcon.astro';
---

<footer class="border-t border-steel/15 bg-bg-deep text-ink" role="contentinfo">
  <div class="max-w-6xl mx-auto px-6 md:px-10 pt-16 pb-12">

    <!-- Top section: Wordmark + Tagline -->
    <div class="flex flex-col md:flex-row md:items-end justify-between border-b border-steel/15 pb-10 gap-6">
      <div>
        <p class="footer-wordmark font-display font-bold text-[clamp(2rem,5vw,3.6rem)] tracking-[-0.03em] text-cream leading-none select-none mb-3">
          AZEDIN BARBER
        </p>
        <p class="text-[13px] md:text-sm text-steel font-medium tracking-wide">
          Cortes de pelo, fades y arreglo de barba con precisión artesanal.
        </p>
      </div>

      <a
        href={business.booksyUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-booksy-link
        class="btn-oak text-[11px] px-6 py-3 self-start md:self-auto"
      >
        Reservar Cita en Booksy
      </a>
    </div>

    <!-- Middle section: 3 Columns Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 py-12 border-b border-steel/15 text-sm">

      <!-- Col 1: Ubicación & Contacto -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[0.2em] text-steel font-semibold">
          Ubicación & Contacto
        </h3>
        <p class="text-ink-dim leading-relaxed">
          Avenida José Barrionuevo Peña 14<br />
          04760, Berja · Almería
        </p>
        <a
          href={`tel:${business.phoneRaw}`}
          class="inline-flex items-center gap-2 text-cream hover:text-oak transition-colors duration-200 text-xs font-semibold"
          aria-label={`Llamar a Azedin Barber: ${business.phone}`}
        >
          <span>📞 {business.phone}</span>
        </a>
        <a
          href="https://maps.app.goo.gl/gvjmsWwo8HRToHvi8"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs text-steel hover:text-cream transition-colors duration-200 uppercase tracking-widest font-semibold pt-1"
          aria-label="Cómo llegar en Google Maps"
        >
          <span>Cómo llegar en Google Maps</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <!-- Col 2: Horarios -->
      <div class="flex flex-col gap-3">
        <h3 class="text-xs uppercase tracking-[0.2em] text-steel font-semibold">
          Horarios de Atención
        </h3>
        <ul class="space-y-1.5 text-ink-dim text-xs">
          <li class="flex justify-between border-b border-steel/10 pb-1">
            <span>Mar – Sáb</span>
            <span class="text-cream font-medium">10:00–14:00 · 16:00–20:00</span>
          </li>
          <li class="flex justify-between border-b border-steel/10 pb-1">
            <span>Lunes</span>
            <span class="text-cream font-medium">15:30 – 20:30</span>
          </li>
          <li class="flex justify-between">
            <span>Domingo</span>
            <span class="text-steel">Cerrado</span>
          </li>
        </ul>
      </div>

      <!-- Col 3: Síguenos & Navegación -->
      <div class="flex flex-col gap-4">
        <h3 class="text-xs uppercase tracking-[0.2em] text-steel font-semibold">
          Síguenos
        </h3>
        <div class="flex flex-col gap-2.5">
          <a
            href={business.instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 text-cream hover:text-oak transition-colors duration-200 text-xs"
            aria-label="Instagram de Azedin Barber @azedinbarber"
          >
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-steel/20">
              <SocialIcon name="instagram" class="w-3.5 h-3.5 fill-current" />
            </span>
            <span class="font-medium tracking-wide">@azedinbarber</span>
          </a>
          <a
            href={business.tiktokUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 text-cream hover:text-oak transition-colors duration-200 text-xs"
            aria-label="TikTok de Azedin Barber @azedin.barber"
          >
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-steel/20">
              <SocialIcon name="tiktok" class="w-3.5 h-3.5 fill-current" />
            </span>
            <span class="font-medium tracking-wide">@azedin.barber</span>
          </a>
        </div>

        <nav class="flex flex-wrap gap-x-4 gap-y-2 pt-2 text-[11px] uppercase tracking-widest text-steel" aria-label="Navegación pie de página">
          <a href="#lookbook" class="hover:text-cream transition-colors duration-180">Lookbook</a>
          <span>·</span>
          <a href="#servicios" class="hover:text-cream transition-colors duration-180">Servicios</a>
          <span>·</span>
          <a href="#reseñas" class="hover:text-cream transition-colors duration-180">Reseñas</a>
          <span>·</span>
          <a href="#ubicacion" class="hover:text-cream transition-colors duration-180">Ubicación</a>
        </nav>
      </div>

    </div>

    <!-- Bottom bar: Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] text-ink-dim gap-3">
      <p class="tracking-wide">
        &copy; {new Date().getFullYear()} Azedin Barber. Todos los derechos reservados.
      </p>
      <p class="text-steel tracking-wide">
        Berja, Almería · España
      </p>
    </div>

  </div>
</footer>



