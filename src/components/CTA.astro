---
/**
 * CTA — Reusable direct booking link button.
 *
 * Direct link to Booksy with smart mobile app deep-linking.
 */
import { business } from '../data/content.js';

interface Props {
  label: string;
  ariaLabel?: string;
  variant?: 'primary' | 'ghost';
  extraClass?: string;
  href?: string;
}

const {
  label,
  ariaLabel,
  variant = 'primary',
  extraClass = '',
  href = business.booksyUrl,
} = Astro.props;

const baseClass = variant === 'ghost' ? 'btn-ghost' : 'btn-oak';
const className = [baseClass, extraClass].filter(Boolean).join(' ');
const finalAriaLabel = ariaLabel ?? label;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-booksy-link
  class={className}
  aria-label={finalAriaLabel}
>{label}</a>