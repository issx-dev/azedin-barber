---
/**
 * One still booking line between the walk and the prices.
 *
 * The tour is the only motion on the page. A looping ticker on top of it
 * turns the shop into a demo. Winston repeats a booking phrase in type and
 * does not animate it; here one line is enough, because the header, the
 * ledger and the sticky bar already carry the same action.
 */
import { business } from '../data/content.js';

const phrase = 'Reserva tu cita';
---

<a
  href={business.booksyUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="ruled-top ruled-bottom group block bg-marmol-2 py-6 text-center md:py-5"
>
  <span
    class="font-display uppercase leading-none text-cal transition-colors duration-240 ease-marmol group-hover:text-roble"
    style="font-size: var(--step-1); font-variation-settings: 'wght' 600;"
  >
    {phrase}
  </span>
</a>
