---
/**
 * Services — the ledger.
 *
 * Prices are visible without a click, because that is the one thing a
 * barbershop customer is actually looking for. Numbered rows, dot leaders,
 * tabular numerals. Not three cards with scissors.
 *
 * Only what Booksy states is printed: the duration and the price. The old
 * "Sin recargo por reserva online" line is not on the listing, so it is gone.
 */
import { services, business } from '../data/content.js';

// "Corte niño" already reads "Consultar" in the price column: do not say it twice.
const noteFor = (s: { price: string | null; note?: string }) =>
  s.price ? s.note : s.note?.replace(/\s*·\s*consultar$/i, '');
---

<section id="servicios" class="section section-end-tight relative" aria-labelledby="servicios-title">
  <div class="frame">
    <header class="section-head ruled-bottom flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
      <div>
        <p class="eyebrow mb-4">Tarifa</p>
        <h2 id="servicios-title" class="text-sect display text-cal">Precios</h2>
      </div>
      <p class="font-body text-cap text-humo md:pb-2">Todos los servicios, 30 min</p>
    </header>

    <ul class="mt-1 md:mt-4">
      {
        services.map((s) => (
          <li class="ledger-row" data-tour-row>
            <span class="w-6 font-body text-cap text-humo tabular">{s.num}</span>
            <span class="flex min-w-0 flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
              <span class="min-w-0 font-body font-semibold uppercase tracking-[0.1em] text-cal sm:tracking-wide">
                {s.name}
              </span>
              <span class="ledger-leader hidden min-w-6 flex-1 sm:block" aria-hidden="true" />
              {noteFor(s) && <span class="font-body text-cap text-humo sm:shrink-0">{noteFor(s)}</span>}
            </span>
            <span class="ledger-price whitespace-nowrap" style="font-size: var(--step-1);">
              {s.price ? `${s.price} €` : 'Consultar'}
            </span>
          </li>
        ))
      }
    </ul>

    <!-- The booking row: one line of what happens next, one button. -->
    <div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8 md:mt-8">
      <p class="font-body text-cal-dim">
        Eliges barbero y hora en Booksy.
      </p>
      <a
        class="btn btn-primary w-full sm:w-auto sm:min-w-[14rem]"
        href={business.booksyUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Reservar
      </a>
    </div>
  </div>
</section>
