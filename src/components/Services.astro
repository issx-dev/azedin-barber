---
/**
 * Services — the ledger.
 *
 * Prices are visible without a click, because that is the one thing a
 * barbershop customer is actually looking for. Rendered as a mine docket:
 * numbered rows, dot leaders, tabular numerals. Not three cards with scissors.
 */
import { services, business } from '../data/content.js';
---

<section id="servicios" class="relative py-20 md:py-30" aria-labelledby="servicios-title">
  <div class="frame">
    <header class="ruled-bottom flex flex-wrap items-end justify-between gap-6 pb-8">
      <div>
        <p class="eyebrow mb-4">Tarifa</p>
        <h2 id="servicios-title" class="text-sect display text-cal">Servicios<br />y precios</h2>
      </div>
      <p class="font-body text-cap text-humo">
        Todos los servicios, 30 min<br />Sin recargo por reserva online
      </p>
    </header>

    <ul class="mt-4">
      {
        services.map((s) => (
          <li class="ledger-row" data-tour-row>
            <span class="font-body text-cap text-humo tabular">{s.num}</span>
            <span class="flex min-w-0 items-baseline gap-4">
              <span
                class="min-w-0 font-display uppercase text-cal"
                style="font-size: var(--step-1); font-variation-settings: 'wght' 600;"
              >
                {s.name}
              </span>
              <span class="ledger-leader hidden min-w-6 flex-1 sm:block" aria-hidden="true"></span>
              {s.note && <span class="hidden shrink-0 font-body text-cap text-humo lg:block">{s.note}</span>}
            </span>
            <span class="ledger-price whitespace-nowrap" style="font-size: var(--step-1);">
              {s.price ? `${s.price} €` : 'Consultar'}
            </span>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a class="btn btn-primary" href={business.booksyUrl} target="_blank" rel="noopener noreferrer">
        Reservar en Booksy
      </a>
      <p class="font-body text-cap text-humo">
        Elige barbero y hora. {business.reviewCount} reseñas verificadas.
      </p>
    </div>
  </div>
</section>
