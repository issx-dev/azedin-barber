---
/**
 * About — the trade, set as a dictionary entry.
 *
 * Structure borrowed from darkroom.engineering: a defined term, numbered
 * senses, a manifesto paragraph in mono. It carries the Berja anchor — the
 * lead mines of Sierra de Gádor — which is the one thing no other barbershop
 * site on earth can claim.
 */
import { business, barbers, shopImages } from '../data/content.js';
import { Image } from 'astro:assets';
---

<section id="oficio" class="relative py-20 md:py-30" aria-labelledby="oficio-title">
  <div class="frame">
    <header class="ruled-bottom pb-8">
      <p class="eyebrow mb-4">El oficio</p>
      <h2 id="oficio-title" class="text-sect uppercase text-caliza">
        <span class="font-mono text-lead">[ plomo ]</span>, sust.
      </h2>
    </header>

    <div class="grid gap-x-10 gap-y-12 pt-10 lg:grid-cols-12">
      <!-- Numbered senses: the term, then the claim. -->
      <ol class="lg:col-span-5">
        <li class="ruled-bottom flex gap-5 pb-6">
          <span class="shrink-0 font-mono text-cap text-lead tabular">1.</span>
          <p class="text-caliza">
            Metal denso y maleable. Se extrajo de la Sierra de Gádor durante
            décadas; Berja vivió de él.
          </p>
        </li>
        <li class="ruled-bottom flex gap-5 py-6">
          <span class="shrink-0 font-mono text-cap text-lead tabular">2.</span>
          <p class="text-caliza">
            Taller donde el corte se mide antes de hacerse. Tijera, navaja y
            máquina; nada de prisa.
          </p>
        </li>
      </ol>

      <div class="lg:col-span-4">
        <p class="font-mono text-cap leading-normal text-lead">
          {business.name} abre en la Avenida José Barrionuevo Peña desde la misma
          idea con la que se bajaba el mineral de la sierra: trabajo medido,
          hecho a mano y comprobable. Tres barberos, una tarifa publicada y
          {business.reviewCount} reseñas con nombre y apellido.
        </p>
        <p class="mt-6 font-mono text-cap uppercase tracking-wide text-caliza">
          {business.tagline}
        </p>
      </div>

      <!-- Placeholder-resolution frame: capped at 420px so it never breaks. -->
      <figure class="lg:col-span-3">
        <div class="relative aspect-card overflow-hidden border border-lead-lo">
          <Image
            src={shopImages.salon.src}
            alt={shopImages.salon.alt}
            width={420}
            height={560}
            widths={[320, 420]}
            sizes="(min-width: 1024px) 320px, 60vw"
            format="avif"
            quality={72}
            class="h-full w-full object-cover grayscale"
          />
        </div>
        <figcaption class="mt-3 font-mono text-cap text-lead">
          El salón · Berja
        </figcaption>
      </figure>
    </div>

    <!-- The team: three barbers, with who does what in plain numbers. -->
    <ul class="ruled-top mt-16 grid gap-x-10 pt-10 sm:grid-cols-3">
      {
        barbers.map((b) => (
          <li class="flex items-baseline gap-4 py-4 sm:block">
            <h3 class="font-display uppercase text-caliza" style="font-size: var(--step-1); font-variation-settings: 'wght' 700, 'wdth' 100;">
              {b.name}
            </h3>
            <p class="font-mono text-cap text-lead sm:mt-2">{b.role} · {b.share}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
