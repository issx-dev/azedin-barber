---
/**
 * Reseñas — a crowd of voices, not a wall of paragraphs.
 *
 * Three layers, each short enough to read at a glance:
 *   1. The number: 5,0 and 179, set large. That alone is the argument.
 *   2. One featured quote that rotates every 6 s (the four long ones), with
 *      name, service and date — still verifiable, never more than ~25 words
 *      on screen at once.
 *   3. One belt of one-line reviews. Pure CSS, pauses on hover/focus,
 *      stops under reduced-motion.
 */
import { reviews, shortReviews, reviewThemes, business } from '../data/content.js';

const featured = reviews.slice(0, 4);
const fmt = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });
---

<section id="resenas" class="relative overflow-hidden py-20 md:py-30" aria-labelledby="resenas-title">
  <div class="frame">
    <div class="grid gap-x-16 gap-y-12 lg:grid-cols-[auto_1fr] lg:items-center">
      <!-- 1. The number. -->
      <div>
        <p class="eyebrow mb-4">Reseñas verificadas · {business.reviewSource}</p>
        <h2 id="resenas-title" class="sr-only">Reseñas</h2>
        <p
          class="font-display leading-none text-cal"
          style="font-size: clamp(4.5rem, 12vw, 9rem); font-variation-settings: 'wght' 600; letter-spacing: -0.04em;"
        >
          {business.rating}
        </p>
        <p class="mt-4 flex items-center gap-3">
          <span class="text-roble tracking-[0.2em]" aria-hidden="true">★★★★★</span>
          <span class="font-body text-cap text-cal-dim tabular">{business.reviewCount} reseñas</span>
        </p>
        <p class="mt-6 font-body text-cap uppercase tracking-wide text-humo">
          {reviewThemes.slice(0, 3).join(' · ')}
        </p>
      </div>

      <!-- 2. One quote at a time — Cormorant italic, not body sans. -->
      <div class="rev-rotator relative min-h-[14rem] border-l border-veta pl-6 md:min-h-[12rem] md:pl-10" aria-live="polite">
        {
          featured.map((r, i) => (
            <figure class="rev-slide absolute inset-0" data-i={i} style={i === 0 ? '' : 'opacity:0;visibility:hidden'}>
              <blockquote>
                <p
                  class="font-display text-cal"
                  style="font-size: clamp(1.35rem, 2.8vw, 2rem); font-style: italic; font-variation-settings: 'wght' 500; text-transform: none; letter-spacing: 0; line-height: 1.3; text-wrap: balance; max-width: 28ch;"
                >
                  “{r.quote}”
                </p>
              </blockquote>
              <figcaption class="mt-6 font-body text-cap text-humo tabular">
                <span class="text-cal">{r.author}</span>
                <span class="mx-2 text-veta" aria-hidden="true">·</span>
                {r.service} con {r.barber}
                <span class="mx-2 text-veta" aria-hidden="true">·</span>
                {fmt(r.date)}
              </figcaption>
            </figure>
          ))
        }
        <div class="absolute -bottom-8 left-0 flex gap-1 md:left-0" role="tablist" aria-label="Elegir reseña">
          {
            featured.map((r, i) => (
              <button
                type="button"
                class="rev-dot relative h-11 w-11 bg-transparent"
                role="tab"
                aria-label={`Reseña de ${r.author}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-i={i}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- 3. One belt — hairline rules, no card chrome. -->
  <div class="mt-24" aria-label="Más reseñas de clientes">
    <div class="rev-belt group flex overflow-hidden">
      {
        [0, 1].map((copy) => (
          <ul class="rev-track flex shrink-0 gap-8 pr-8" aria-hidden={copy === 1 ? 'true' : undefined}>
            {shortReviews.map((r) => (
              <li class="flex shrink-0 items-baseline gap-3 border-b border-veta pb-3">
                <span class="whitespace-nowrap font-body text-cal">“{r.quote}”</span>
                <span class="whitespace-nowrap font-body text-cap uppercase tracking-wide text-humo">{r.author}</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <p class="frame mt-10 font-body text-cap text-humo">
    Todas de clientes con reserva confirmada.
    <a href={business.booksyProfileUrl} target="_blank" rel="noopener noreferrer" class="text-cal underline decoration-veta underline-offset-4 hover:decoration-roble">
      Ver las {business.reviewCount} en Booksy
    </a>
  </p>
</section>

<style>
  .rev-track {
    animation: rev-left 60s linear infinite;
  }
  .rev-belt:hover .rev-track,
  .rev-belt:focus-within .rev-track {
    animation-play-state: paused;
  }
  @keyframes rev-left {
    to { transform: translateX(-100%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rev-track { animation: none; }
    .rev-belt { overflow-x: auto; }
  }
  .rev-slide {
    transition: opacity 420ms var(--ease-led), visibility 0s linear 420ms;
  }
  .rev-slide.is-on {
    transition: opacity 420ms var(--ease-led), visibility 0s;
  }
  .rev-dot::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2rem;
    height: 2px;
    transform: translate(-50%, -50%);
    background: var(--c-veta);
    transition: background-color 240ms var(--ease-led);
  }
  .rev-dot[aria-selected='true']::after {
    background: var(--c-roble);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.rev-rotator');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.rev-slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.rev-dot')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer = 0;

    function show(n: number) {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        const on = k === i;
        s.classList.toggle('is-on', on);
        s.style.opacity = on ? '1' : '0';
        s.style.visibility = on ? 'visible' : 'hidden';
      });
      dots.forEach((d, k) => d.setAttribute('aria-selected', String(k === i)));
    }
    function play() {
      if (reduced) return;
      clearInterval(timer);
      timer = window.setInterval(() => show(i + 1), 6000);
    }
    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.i)); play(); }));
    // Never rotate while someone is reading it.
    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', play);
    root.addEventListener('focusin', () => clearInterval(timer));
    // Only rotate while visible.
    new IntersectionObserver(([e]) => (e.isIntersecting ? play() : clearInterval(timer))).observe(root);
    show(0);
  }
</script>
