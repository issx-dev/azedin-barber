---
/**
 * Reseñas — the number, one voice, then a crowd.
 *
 *   1. The number: 5,0 and 202, set large. That alone is the argument.
 *   2. One featured quote, upright Cormorant (the italic was hard to read on
 *      a phone). The other three are there if you tap a dash. Nothing
 *      rotates: the tour is the only motion on the page. The dashes sit
 *      above the quote and all four quotes share one grid cell, so a tap
 *      never moves the controls or the page.
 *   3. Short reviews in a still grid.
 *
 * The "profesionalidad · detalle · buen trato" line came from an old reading
 * of ~60 reviews, not the 202 on Booksy now, so it is not printed.
 */
import { reviews, shortReviews, business } from '../data/content.js';

const featured = reviews.slice(0, 4);
const fmt = (iso: string) => new Date(iso).toLocaleDateString('es-ES', { month: 'short', year: 'numeric' });
---

<section id="resenas" class="relative overflow-hidden py-20 md:py-30" aria-labelledby="resenas-title">
  <div class="frame">
    <header class="ruled-bottom pb-6">
      <p class="eyebrow">Reseñas verificadas · {business.reviewSource}</p>
      <h2 id="resenas-title" class="sr-only">Reseñas</h2>
    </header>

    <div class="grid gap-x-16 gap-y-10 pt-10 lg:grid-cols-12 lg:items-start lg:pt-14">
      <!-- 1. The number. -->
      <div class="flex items-end gap-5 lg:col-span-4 lg:flex-col lg:items-start lg:gap-4">
        <p
          class="font-display leading-none text-cal"
          style="font-size: clamp(4.5rem, 3rem + 7vw, 9rem); font-variation-settings: 'wght' 600; letter-spacing: -0.04em;"
        >
          {business.rating}
        </p>
        <p class="flex flex-col gap-1 pb-2 lg:pb-0">
          <span class="text-roble tracking-[0.2em]" aria-hidden="true">★★★★★</span>
          <span class="font-body text-cap text-cal-dim tabular">{business.reviewCount} reseñas</span>
        </p>
      </div>

      <!-- 2. One quote at a time. -->
      <div class="rev-rotator lg:col-span-8 lg:border-l lg:border-veta lg:pl-16">
        <div class="-ml-1.5 -mt-3 mb-2 flex lg:mb-4" role="group" aria-label="Elegir reseña">
          {
            featured.map((r, i) => (
              <button
                type="button"
                class="rev-dot relative h-11 w-11 bg-transparent"
                aria-label={`Reseña de ${r.author}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-i={i}
              />
            ))
          }
        </div>
        <div class="rev-stack">
          {
            featured.map((r, i) => (
              <figure class="rev-slide" data-i={i} hidden={i === 0 ? undefined : true}>
                <blockquote>
                  <p
                    class="font-display text-cal"
                    style="font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.375rem); font-variation-settings: 'wght' 500; text-transform: none; letter-spacing: 0; line-height: 1.25; text-wrap: pretty; max-width: 30ch;"
                  >
                    “{r.quote}”
                  </p>
                </blockquote>
                <figcaption class="mt-5 font-body text-cap text-humo tabular">
                  <span class="text-cal">{r.author}</span>
                  <span class="mx-2 text-veta" aria-hidden="true">·</span>
                  {r.service} con {r.barber}
                  <span class="mx-2 text-veta" aria-hidden="true">·</span>
                  {fmt(r.date)}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>

    <!-- 3. Short reviews, still. Four on a phone, six from two columns up. -->
    <ul class="mt-14 grid gap-x-12 border-t border-veta sm:grid-cols-2 lg:mt-20 lg:grid-cols-3" aria-label="Más reseñas de clientes">
      {
        shortReviews.slice(0, 6).map((r, i) => (
          <li class:list={['border-b border-veta py-5', i >= 4 && 'hidden sm:block']}>
            <p class="font-body text-cal" style="text-wrap: pretty;">“{r.quote}”</p>
            <p class="mt-1.5 font-body text-cap uppercase tracking-wide text-humo">{r.author}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 font-body text-cap text-humo">
      Todas de clientes con reserva confirmada.
      <a href={business.booksyProfileUrl} target="_blank" rel="noopener noreferrer" class="text-cal underline decoration-veta underline-offset-4 hover:decoration-roble">
        Ver las {business.reviewCount} en Booksy
      </a>
    </p>
  </div>
</section>

<style>
  /* All slides in one cell: the tallest sets the height, so tapping a dash
     never shifts what is below. Hidden ones keep their space, not their ink. */
  .rev-stack {
    display: grid;
  }
  .rev-slide {
    grid-area: 1 / 1;
  }
  .rev-slide[hidden] {
    display: block;
    visibility: hidden;
  }

  .rev-dot::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2rem;
    height: 2px;
    transform: translate(-50%, -50%);
    background: var(--c-veta);
    transition: background-color 240ms var(--ease-led);
  }
  .rev-dot:hover::after {
    background: var(--c-humo);
  }
  .rev-dot[aria-pressed='true']::after {
    background: var(--c-roble);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.rev-rotator');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.rev-slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.rev-dot')];
    let i = 0;

    function show(n: number) {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => {
        s.hidden = k !== i;
      });
      dots.forEach((d, k) => d.setAttribute('aria-pressed', String(k === i)));
    }
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.i))));
    show(0);
  }
</script>
