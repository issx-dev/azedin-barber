---
/**
 * Hero — the poster.
 *
 * No background photo on purpose: the only available imagery is 360–481px
 * wide (Instagram), which cannot survive a full-bleed treatment on retina.
 * The name is set at signage scale against the real left edge of the viewport,
 * and the hard facts sit underneath in mono — address, hours, price, rating.
 * Every pixel here is a datum that could only belong to this shop in Berja.
 */
import { business, services } from '../data/content.js';

const cheapest = services.find((s) => s.name === 'Corte de pelo');
---

<section class="grain relative overflow-hidden pt-28 md:pt-36" aria-labelledby="hero-title">
  <!-- Drawn grid: the structure is meant to be seen, like a workshop plan. -->
  <div class="grid-lines pointer-events-none absolute inset-0 hidden md:block" aria-hidden="true"></div>

  <div class="frame relative">
    <p class="eyebrow mb-6 md:mb-10">Berja · Almería</p>

    <!-- The name. Two lines, flush left, no centring. -->
    <h1 id="hero-title" class="poster" data-poster>
      <span class="block" data-poster-line>Barbería</span>
      <span class="block text-gules" data-poster-line>Azedin</span>
    </h1>

    <!-- Two sentences, not one with a mid-phrase colour change: the emphasis
         must read as a decision, not as a styling accident. -->
    <p class="mt-8 max-w-measure font-body text-lead" style="font-size: var(--step-1); line-height: 1.3;">
      {business.tagline}. Tres barberos y cita en treinta segundos.
      <span class="text-caliza">La barbería más valorada de Berja.</span>
    </p>

    <!-- Hard facts, mono, tabular. The docket, not a row of cards. -->
    <dl class="ruled-top mt-12 grid grid-cols-2 gap-y-6 pt-8 md:grid-cols-4">
      <div>
        <dt class="eyebrow">Valoración</dt>
        <dd class="mt-2 font-mono tabular text-caliza">
          {business.rating} ★ · {business.reviewCount} reseñas
        </dd>
      </div>
      <div>
        <dt class="eyebrow">Corte desde</dt>
        <dd class="mt-2 font-mono tabular text-caliza">{cheapest?.price}&nbsp;€ · {cheapest?.minutes}&nbsp;min</dd>
      </div>
      <div>
        <dt class="eyebrow">Dirección</dt>
        <dd class="mt-2 font-mono text-caliza">{business.address}</dd>
      </div>
      <div>
        <dt class="eyebrow">Teléfono</dt>
        <dd class="mt-2 font-mono tabular">
          <a href={`tel:${business.phoneRaw}`} class="text-caliza underline decoration-lead-lo underline-offset-4 hover:decoration-gules">
            {business.phone}
          </a>
        </dd>
      </div>
    </dl>

    <div class="mt-10 flex flex-wrap gap-3 pb-20 md:pb-30">
      <a class="btn btn-primary" href={business.booksyUrl} target="_blank" rel="noopener noreferrer">
        Reservar cita
      </a>
      <a class="btn btn-ghost" href="#servicios">Ver precios</a>
    </div>
  </div>
</section>
