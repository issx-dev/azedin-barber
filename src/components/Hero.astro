---
/**
 * Hero — the shop, and the logo.
 *
 * Winston Studio's lesson: the home page is a face and a button. Here it is
 * the room itself — the 4K walkthrough the client shot, trimmed to a 7.5 s
 * loop — with the real calligraphic logo over it. No invented headline: the
 * wordmark IS the headline, exactly as it is on their window.
 *
 * Video rules (all measured): muted+playsinline or iOS blocks autoplay; the
 * poster is the real LCP (42 KB AVIF, same first frame); preload=metadata;
 * paused off-screen; dropped entirely for reduced-motion and Save-Data.
 */
import { business } from '../data/content.js';
import Logo from './Logo.astro';
import BarberPole from './BarberPole.astro';
---

<section
  id="hero"
  class="relative flex min-h-[100svh] flex-col justify-end overflow-hidden"
  aria-labelledby="hero-title"
>
  <!-- The room. -->
  <video
    class="hero-video absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-led"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/img/hero-poster.jpg"
    aria-hidden="true"
    disablepictureinpicture
    disableremoteplayback
  >
    <source src="/video/hero-1080.webm" type="video/webm" media="(min-width: 768px)" />
    <source src="/video/hero-1080.mp4" type="video/mp4" media="(min-width: 768px)" />
    <source src="/video/hero-720.mp4" type="video/mp4" />
  </video>
  <!-- Poster also as an <img> so the LCP element is a real image, not the video. -->
  <img
    src="/img/hero-poster.avif"
    alt=""
    width="1920"
    height="1080"
    fetchpriority="high"
    decoding="async"
    class="hero-poster absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  />

  <!-- Contrast: leather-black lifting from the bottom for the wordmark, and a
       thinner veil at the top so the nav stays legible over the slats. -->
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-piel via-piel/50 to-marmol/40"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-marmol/80 to-transparent"
    aria-hidden="true"
  ></div>

  <!-- The pole, mounted at the right edge like the one on the façade. -->
  <BarberPole
    class="absolute right-[var(--gutter)] top-[calc(50%-clamp(130px,22vh,250px))] hidden md:block"
    width="clamp(52px, 5vw, 84px)"
    height="clamp(260px, 44vh, 500px)"
    speed={0.3}
    tilt={0}
    label="Rulo de barbero"
  />

  <div class="frame relative pb-14 pt-40 md:pb-20">
    <p class="eyebrow mb-8 text-cal-dim">Barbería · Berja, Almería · desde 2020</p>

    <!-- The wordmark is the H1. Visible name for sighted users is the logo;
         the accessible name is the text. -->
    <h1 id="hero-title" class="m-0">
      <span class="sr-only">{business.legalName}</span>
      <Logo class="h-auto w-[min(78vw,560px)] text-cal" data-logo />
    </h1>

    <p class="display mt-10 text-h3" style="font-variation-settings: 'wght' 500;">
      {business.tagline}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
      <a class="btn btn-primary" href={business.booksyUrl} target="_blank" rel="noopener noreferrer">
        Reservar cita
      </a>
      <p class="font-body text-cap text-cal-dim tabular">
        <span class="text-pino">{business.rating} ★</span> · {business.reviewCount} reseñas verificadas
      </p>
    </div>
  </div>
</section>

<script>
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  const poster = document.querySelector<HTMLImageElement>('.hero-poster');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;

  if (v) {
    if (reduced || saveData) {
      // Keep the poster; never download a byte of video.
      v.removeAttribute('autoplay');
      v.querySelectorAll('source').forEach((s) => s.remove());
      v.load();
    } else {
      v.addEventListener(
        'loadeddata',
        () => {
          v.classList.remove('opacity-0');
          poster?.classList.add('opacity-0');
        },
        { once: true }
      );
      v.play().catch(() => {}); // iOS low-power: poster stays
      new IntersectionObserver(([e]) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause()), {
        threshold: 0.1,
      }).observe(v);
    }
  }
</script>

<style>
  .hero-poster {
    transition: opacity 700ms var(--ease-led);
  }
</style>
