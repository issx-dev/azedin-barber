---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Services from '../components/Services.astro';
import Lookbook from '../components/Lookbook.astro';
import Reviews from '../components/Reviews.astro';
import About from '../components/About.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
---

<Layout>
  <Header />

  <!--
    Running order. Prices come before the gallery on purpose: it is the one
    thing a barbershop customer is looking for, and the thing nearly every
    barbershop site buries. The shop's story comes last — the home page is
    the booking button, not an autobiography.
  -->
  <main id="main-content">
    <Hero />
    <Marquee />
    <Services />
    <Lookbook />
    <Reviews />
    <About />
    <Location />
  </main>

  <Footer />
  <MobileStickyCTA />
</Layout>
