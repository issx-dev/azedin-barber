---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Barbers from '../components/Barbers.astro';
import Lookbook from '../components/Lookbook.astro';
import Services from '../components/Services.astro';
import Reviews from '../components/Reviews.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import About from '../components/About.astro';
import InstagramStrip from '../components/InstagramStrip.astro';
import MobileNav from '../components/MobileNav.astro';
import logoSrc from '../assets/img/logo-azedin-barber-transparente.png';
---

<Layout>
  <Header />

  <main id="main-content">
    <Hero />
    <Barbers />
    <Reviews />
    <Lookbook />
    <Services />
    <About />
    <Location />
    <InstagramStrip />
  </main>

  <Footer />

  <!-- Interactive Elements -->
  <MobileNav
    logoSrc={logoSrc.src}
  />
</Layout>

